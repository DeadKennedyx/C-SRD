; E(x)=x xor mask. All payloads and masks range over every 32-bit value.
(set-logic QF_BV)
(declare-const x (_ BitVec 32))
(declare-const y (_ BitVec 32))
(declare-const mask (_ BitVec 32))
(declare-const k (_ BitVec 32))
(define-fun E ((v (_ BitVec 32))) (_ BitVec 32) (bvxor v mask))
(push)
(assert (not (= (bvxor (bvxor (E x) (E y)) mask) (E (bvxor x y)))))
(check-sat)
(pop)
(push)
(assert (not (= (bvxor (bvand (E x) (E y)) (bvand (bvxor (E x) (E y)) mask)) (E (bvand x y)))))
(check-sat)
(pop)
(push)
(assert (not (= (bvxor (bvor (E x) (E y)) (bvand (bvxor (E x) (E y)) mask)) (E (bvor x y)))))
(check-sat)
(pop)
(push)
(assert (not (= (bvnot (E x)) (E (bvnot x)))))
(check-sat)
(pop)
(push)
(assert (bvult k (_ bv32 32)))
(assert (not (= (bvxor (bvshl (E x) k) (bvxor (bvshl mask k) mask)) (E (bvshl x k)))))
(check-sat)
(pop)
(push)
(assert (bvult k (_ bv32 32)))
(assert (not (= (bvxor (bvlshr (E x) k) (bvxor (bvlshr mask k) mask)) (E (bvlshr x k)))))
(check-sat)
(pop)
