; Counterexamples to three generic rules. All symbols range over all 32-bit values.
; a need not be odd for these identities; oddness is required for decoding.
(set-logic QF_BV)
(declare-const a (_ BitVec 32))
(declare-const b (_ BitVec 32))
(declare-const x (_ BitVec 32))
(declare-const y (_ BitVec 32))
(declare-const k (_ BitVec 32))
(define-fun E ((v (_ BitVec 32))) (_ BitVec 32) (bvadd (bvmul a v) b))
(push)
(assert (not (= (bvsub (bvadd (E x) (E y)) b) (E (bvadd x y)))))
(check-sat-using (then (using-params simplify :som true) smt))
(pop)
(push)
(assert (not (= (bvadd (bvsub (E x) (E y)) b) (E (bvsub x y)))))
(check-sat-using (then (using-params simplify :som true) smt))
(pop)
(push)
(assert (not (= (bvadd (bvmul k (E x)) (bvmul (bvsub (_ bv1 32) k) b)) (E (bvmul k x)))))
(check-sat-using (then (using-params simplify :som true) smt))
(pop)
